NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/saheli_safar
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0

# Generate distinct random values of at least 32 bytes.
JWT_ACCESS_SECRET=<generate-a-random-secret-at-least-32-bytes>
JWT_ONBOARDING_SECRET=<generate-a-different-random-secret-at-least-32-bytes>

# SMTP must be configured to deliver password recovery emails.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password-or-provider-app-password>
# Use the exact SaheliSafar.team sender address verified with your SMTP provider.
EMAIL_FROM=
CONTACT_INBOX=<support-email@example.com>

# Trusted URL of the Admin Dashboard; never derived from request headers.
ADMIN_FRONTEND_URL=http://localhost:5173
