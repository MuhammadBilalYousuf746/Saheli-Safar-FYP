{
  "expo": {
    "name": "Saheli Safar",
    "slug": "saheli-safar-passenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-withoutbg-text.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17131F"
      },
      "backgroundColor": "#17131F"
    },
    "web": {
      "backgroundColor": "#17131F",
      "themeColor": "#17131F"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17131F",
          "image": "./assets/logo-withoutbg-text.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Saheli Safar to select identity images for manual verification.",
          "cameraPermission": "Allow Saheli Safar to capture identity images for manual verification.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "saheli-safar-passenger",
    "backgroundColor": "#17131F"
  }
}
